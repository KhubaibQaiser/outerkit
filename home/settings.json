{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.agent-guard/run.sh --tool claude",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.agent-guard/run.sh --tool claude",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "postman@claude-plugins-official": true,
    "brag@brag": true,
    "impeccable@impeccable": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "brag": {
      "source": {
        "source": "github",
        "repo": "latent-spaces/brag"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    }
  },
  "theme": "auto",
  "agentPushNotifEnabled": true,
  "model": "sonnet"
}
